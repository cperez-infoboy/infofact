# Agent sandbox image: one container per user, started with `sleep infinity`.
# The backend talks to it only via `docker exec` (no exposed ports).
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 python3-pip python3-venv \
      nodejs npm \
      curl wget jq zip unzip ca-certificates openssh-client \
      ripgrep fd-find bat fzf build-essential \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && ln -sf /usr/bin/batcat /usr/local/bin/bat \
    && rm -rf /var/lib/apt/lists/*

# eza from the GitHub release tarball (the eza.rs install endpoint is flaky).
RUN curl -fsSL https://github.com/eza-community/eza/releases/latest/download/eza_x86_64-unknown-linux-gnu.tar.gz \
    | tar -xz -C /usr/local/bin

# Reclaim uid 1000 for `agent`. ubuntu:24.04 ships an `ubuntu` user at 1000;
# the host-side workspace dirs are created uid 1000, so the in-container user
# must match for read-write access to the bind mount.
RUN userdel -r ubuntu 2>/dev/null || true \
    && useradd -m -u 1000 -s /bin/bash agent

# Offload del resumen (SummarizationMiddleware de deepagents): el path
# /conversation_history/<session>.md es fijo en el middleware y se escribe
# a traves del backend del agente, es decir DENTRO de este container como
# uid 1000. Sin este directorio, cada resumen falla con PermissionError y
# el historial previo queda sin respaldo.
RUN mkdir -p /conversation_history && chown agent:agent /conversation_history

USER agent
WORKDIR /workspaces

CMD ["sleep", "infinity"]
